# =============================================================================
# Leo Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values

# ===================
# REQUIRED - Core Leo
# ===================

# Google AI / Gemini (required for AI features)
# Get one at: https://ai.google.dev/
GOOGLE_AI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Mapbox Token (required for frontend maps)
# Get one at: https://www.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Backend URL (defaults to localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===================
# OPTIONAL - Features
# ===================

# ScrapingDog API Key (for competitor scraping tool)
SCRAPINGDOG_API_KEY=your_scrapingdog_key_here

# ===================
# AWS (REQUIRED for Cloud-Native Geospatial)
# ===================
# Used by tools_athena.py for Overture queries
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Athena Configuration
ATHENA_DATABASE=overture
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_LOCATION=s3://your-bucket/athena-results/

# S3 (for pre-computation scripts)
AWS_S3_BUCKET=your_bucket_name

# Stripe (if adding payments)
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_RENTER_PRICE_ID=price_xxx
STRIPE_BUYER_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend (if adding email)
RESEND_API_KEY=re_xxx

# ===================
# NOTE: GitHub
# ===================
# GitHub auth is handled via `gh auth login` (stored in system keyring)
# No env var needed - works across all Cursor projects automatically
